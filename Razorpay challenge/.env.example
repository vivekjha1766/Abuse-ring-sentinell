# ============================================================
# Abuse-Ring Sentinel — Example Environment Configuration
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# All values below are safe non-secret defaults / placeholders.
# ============================================================

# ---- Application ----
APP_ENV=development                 # development | staging | production
APP_NAME=abuse-ring-sentinel
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed origins for CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (PostgreSQL) ----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL. For local dev without Postgres you may use SQLite:
#   DATABASE_URL=sqlite:///./data/sentinel.sqlite3
DATABASE_URL=postgresql+psycopg://sentinel:change_me_local_only@localhost:5432/sentinel

# ---- Security ----
# Generate a strong random value for real deployments, e.g. `openssl rand -hex 32`
SECRET_KEY=replace_with_random_secret_in_real_deployments
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Simple rate-limit knobs (requests per window, seconds)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Synthetic data generation ----
# Master seed drives full reproducibility of the synthetic ecosystem.
SENTINEL_SEED=42
FRAUD_PREVALENCE=0.05               # primary synthetic benchmark configuration
DATASET_SIZE=transactions          # profile name resolved in simulator/config.py

# ---- Cost model (synthetic benchmark assumptions, NOT real banking costs) ----
FP_COST=15
FN_COST=450

# ---- AI Copilot (optional, late-stage) ----
# If unset, the Copilot falls back to a deterministic mock interface.
LLM_PROVIDER=mock                   # mock | anthropic | openai
LLM_API_KEY=
LLM_MODEL=
