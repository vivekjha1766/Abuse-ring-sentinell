artifacts/models/*
artifacts/preprocessing/*
artifacts/reports/*
!artifacts/**/.gitkeep
*.parquet
*.duckdb
*.sqlite
*.sqlite3
*.db

# ---- ML / notebooks ----
.ipynb_checkpoints/
mlruns/
*.pkl
*.joblib
*.model

